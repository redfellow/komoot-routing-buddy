{
	"manifest_version": 3,
	"name": "Komoot Routing Buddy",
	"version": "1.4.0",
	"description": "Make MTB trail difficulty easier to read in the Komoot route planner.",
	"permissions": ["storage", "unlimitedStorage", "declarativeNetRequestWithHostAccess", "alarms"],
	"action": {
		"default_title": "Komoot Routing Buddy",
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icon-rounded.png",
			"32": "icon-rounded.png"
		}
	},
	"content_scripts": [
		{
			"matches": [
				"https://www.komoot.com/tour/*/zoom",
				"https://www.komoot.com/tour/*/zoom?*",
				"https://www.komoot.com/tour/*/edit",
				"https://www.komoot.com/tour/*/edit?*",
				"https://www.komoot.com/plan",
				"https://www.komoot.com/plan?*",
				"https://www.komoot.com/plan/*"
			],
			"js": [
				"browser-api.js",
				"settings.js",
				"sidebar.js",
				"route-check.js",
				"route-dialog.js",
				"content.js"
			],
			"css": ["planner.css"],
			"run_at": "document_idle"
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["map-bridge.js", "hazard-icons.png", "popup.html"],
			"matches": ["https://www.komoot.com/*"]
		}
	],
	"background": {
		"service_worker": "background-worker.js"
	},
	"icons": {
		"16": "icon-rounded.png",
		"32": "icon-rounded.png",
		"48": "icon-rounded.png",
		"128": "icon-rounded.png"
	},
	"host_permissions": [
		"https://overpass.private.coffee/*",
		"https://maps.mail.ru/osm/tools/overpass/*",
		"https://overpass-api.de/*",
		"https://download.geofabrik.de/*"
	]
}
